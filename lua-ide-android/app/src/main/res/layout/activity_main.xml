<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0B09">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#0C0B09">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LUA IDE"
            android:textColor="#E9E1CF"
            android:textSize="16sp"
            android:fontFamily="serif"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/projectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="weather_app \u2304"
            android:textColor="#B98F56"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navPalette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2318"
            android:textColor="#766E5E"
            android:textSize="16sp"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/fileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B98F56"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="main.lua" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#221F19" />

    <!-- editor -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:textColor="#4A4436"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:gravity="end|top"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:text="1" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <com.luaide.app.CodeEditText
                        android:id="@+id/editor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="match_parent"
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:textColor="#A89F8C"
                        android:textColorHint="#4A4436"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:gravity="top"
                        android:padding="16dp"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="20" />
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/runButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:text="\u25B6"
            android:textColor="#0C0B09"
            android:textSize="18sp"
            android:backgroundTint="#B98F56"
            android:elevation="8dp" />
    </FrameLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#221F19" />

    <!-- diagnostics -->
    <TextView
        android:id="@+id/diagnosticsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1712"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:fontFamily="monospace"
        android:textColor="#9A5648"
        android:textSize="10.5sp"
        android:visibility="gone"
        android:text="" />

    <!-- autocomplete strip -->
    <HorizontalScrollView
        android:id="@+id/suggestionScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141210"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/suggestionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp" />
    </HorizontalScrollView>

    <!-- bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#0C0B09">

        <TextView android:id="@+id/navFiles" style="@style/NavItem" android:text="FILES" />
        <TextView android:id="@+id/navSearch" style="@style/NavItem" android:text="SEARCH" />
        <TextView android:id="@+id/navTerminal" style="@style/NavItem" android:text="TERM" />
        <TextView android:id="@+id/navMore" style="@style/NavItem" android:text="MORE" />
    </LinearLayout>

</LinearLayout>
